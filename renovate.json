{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "default:automergePatch",
    "default:automergeRequireAllStatusChecks",
    "default:automergePr",
    "group:recommended"
  ],
  "assignees": ["jpjonte"],
  "ignorePaths": [
    "**/android/**",
    "**/ios/**",
    "**/macos/**"
  ],
  "ignoreDeps": ["nesd_audio", "nesd_texture"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "groupName": "Dart packages",
      "groupSlug": "dart",
      "matchManagers": ["pub"],
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchManagers": ["pub"],
      "matchPackageNames": ["dart"],
      "rangeStrategy": "auto"
    },
    {
      "description": "Linux bundles are built on Ubuntu 22.04 for maximum compatibility",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ubuntu"],
      "enabled": false
    }
  ]
}
